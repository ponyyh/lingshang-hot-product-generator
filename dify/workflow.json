        "data": {
          "title": "提取商品关键词",
          "desc": "排除无关信息，仅保留当前商品的有效关键词",
          "type": "llm",
          "selected": false,
          "variables": [],
          "context": {
            "enabled": false,
            "variable_selector": []
          },
          "model": {
            "completion_params": {
              "temperature": 0.1

            "mode": "chat",
            "name": "deepseek-v4-flash",
            "provider": "langgenius/deepseek/deepseek"
          },
          "prompt_template": [
            {
              "id": "keyword-sys",
              "role": "system",
              "text": "你是电商商品关键词提取专家。请从网页正文中识别“当前主商品”，排除所有无关内容，只保留能够准确描述该商品的关键词。\n\n必须排除：导航菜单、页头页尾、登录注册、广告活动、价格、销量、库存、店铺名称、物流售后、评论问答、推荐商品、猜你喜欢、其他商品、平台通用文案、重复词、空泛形容词、广告极限词。\n\n优先保留：商品品类、品牌（页面明确且确属当前商品时）、型号、材质、颜色、规格、款式、适用对象/场景、核心功能与真实卖点。不得臆测网页未提供的信息。\n\n只输出严格 JSON，不要 Markdown、解释或额外文字：{\"keywords\":[\"关键词1\",\"关键词2\"]}\n关键词去重，按重要性排序，输出 5~15 个；无法识别当前商品时输出：{\"keywords\":[]}"
            },
            {
              "id": "keyword-user",
              "role": "user",
              "text": "商品链接：{{#1700000000001.hot_link#}}\n网页清洗正文：\n{{#1795342000001.clean_text#}}\n当前商品分享标题（明确提供时可作为提取来源）：{{#1700000000001.hot_title#}}\n标题/正文为空时不得猜测。"
            }
          ],
          "vision": {
            "enabled": false
          },
          "reasoning_format": "separated"
        },
        "zIndex": 0,
        "selected": false

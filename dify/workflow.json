        "width": 242,
        "height": 96,
        "data": {
          "title": "清洗网页正文",
          "desc": "移除脚本、样式、HTML 标签及多余空白，限制文本长度",
          "type": "code",
          "selected": false,
          "variables": [
            {
              "variable": "html",
              "value_selector": [
                "1795340978322",
                "body"
              ]
            },
            {
              "variable": "hot_title",
              "value_selector": [
                "1700000000001",
                "hot_title"
              ]
            }
          ],
          "code_language": "python3",
          "code": "import re\nimport json\nimport html as html_lib\n\ndef main(html: str, hot_title: str = \"\") -> dict:\n    raw = html or \"\"\n    fragments = []\n    if hot_title.strip():\n        fragments.append(\"用户提供的当前商品分享标题：\" + hot_title.strip())\n    for m in re.finditer(r'(?is)<meta\\b[^>]*>', raw):\n        tag = m.group(0)\n        if re.search(r'(?:og:title|og:description|twitter:title|description|keywords)', tag, re.I):\n            content = re.search(r'''content\\s*=\\s*[\"'](.*?)[\"']''', tag, re.I)\n            if content:\n                fragments.append(html_lib.unescape(content.group(1)))\n    for m in re.finditer(r'''(?i)[\"']?(?:title|itemTitle|item_name|itemName|goodsName|shareTitle)[\"']?\\s*:\\s*(\"(?:\\\\.|[^\"\\\\])*\")''', raw):\n        try:\n            value = json.loads(m.group(1))\n            if isinstance(value, str) and 5 <= len(value) <= 500:\n                fragments.append(value)\n        except Exception:\n            pass\n    text = re.sub(r'(?is)<(script|style|noscript|svg|iframe)[^>]*>.*?</\\1>', ' ', raw)\n    text = re.sub(r'(?is)<!--.*?-->', ' ', text)\n    text = html_lib.unescape(re.sub(r'(?s)<[^>]+>', ' ', text))\n    text = re.sub(r'\\s+', ' ', text).strip()\n    if text:\n        fragments.append(text)\n    result = '\\n'.join(dict.fromkeys(fragments))[:30000]\n    return {\"clean_text\": result}\n",
          "outputs": {
            "clean_text": {
              "type": "string",
              "children": null
            }
          }
        },

# 复制为 .env 供本地运行；线上在部署平台的环境变量里配置，密钥不要提交到仓库。

# —— 跨域 ——
# 允许的前端来源，逗号分隔；测试环境可用 *，正式环境请写前端域名
ALLOWED_ORIGINS=*

# —— 鉴权 ——
# true：除 /api/health、/api/auth/login 外都要 Authorization: Bearer <token>
AUTH_REQUIRED=true
# 签发令牌用的随机串（至少 32 位），例如：openssl rand -hex 32
AUTH_SECRET=
# 测试账号，格式 用户名:密码，多个用逗号分隔
TEST_ACCOUNTS=
TOKEN_TTL_SECONDS=86400

# —— Agent（OpenAI 兼容的对话接口，默认火山方舟）——
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
# 方舟推理接入点 ID（ep-...）或模型名
ARK_MODEL=
# 模型支持关闭深度思考时设为 true，可明显缩短耗时
ARK_DISABLE_THINKING=false

# —— 超时（毫秒）——
# Agent 单次请求总预算；前端 30 秒超时，所以这里留在 27 秒内
AGENT_BUDGET_MS=27000
LLM_TIMEOUT_MS=10000
LINK_FETCH_TIMEOUT_MS=6000

# —— 可选：本机开着全局代理且代理连不上方舟时，让模型请求从指定网卡直连 ——
# ARK_LOCAL_ADDRESS=本机网卡 IP，例如 192.168.1.4
# ARK_CONNECT_IP=方舟域名解析出的真实 IP

# —— 亚马逊商品数据服务（ScraperAPI）——
# 服务器直连亚马逊被拦截时，用它读取商品页；一次亚马逊读取消耗 5 个额度
SCRAPER_API_KEY=
SCRAPER_TIMEOUT_MS=20000
# true：亚马逊链接一律走商品数据服务，不先尝试直连
SCRAPER_ALWAYS=false

PORT=8787
